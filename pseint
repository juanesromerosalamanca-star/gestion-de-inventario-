Proceso SistemaInventarioLaboratorio
    Definir opcion, sub_opcion Como Entero
    Definir total_estudiantes Como Entero
    
    // Arreglos para almacenar estudiantes (Simulando la base de datos)
    Definir ids_estudiantes, contrasenas_estudiantes, correos_estudiantes, telefonos_estudiantes Como Caracter
    Dimension ids_estudiantes[100]
    Dimension contrasenas_estudiantes[100]
    Dimension correos_estudiantes[100]
    Dimension telefonos_estudiantes[100]
    
    // Variables auxiliares para búsqueda y validación
    Definir id_ingresado, pass_ingresado, correo_nuevo, telefono_nuevo Como Caracter
    Definir encontrado Como Logico
    Definir i, pos Como Entero
    
    // Inicializar con un estudiante por defecto (igual que en tu Python)
    total_estudiantes <- 1
    ids_estudiantes[1] <- "ES01"
    contrasenas_estudiantes[1] <- "1234"
    correos_estudiantes[1] <- "estudiante1@correo.com"
    telefonos_estudiantes[1] <- "3001234567"
    
    Repetir
        Escribir ""
        Escribir "1. Ingresar como Encargado"
        Escribir "2. Ingresar como Estudiante"
        Escribir "3. Registrarse como nuevo Estudiante"
        Escribir "4. Salir"
        Escribir "Seleccione una opcion: "
        Leer opcion
        
        Segun opcion Hacer
            1:
                // --- LOGIN ENCARGADO (Simplificado de prueba) ---
                Definir cuenta, pass_enc Como Caracter
                Escribir "Cuenta: "
                Leer cuenta
                Escribir "Contrasena: "
                Leer pass_enc
                
                Si cuenta == "admin" Y pass_enc == "1234" Entonces
                    Repetir
                        Escribir ""
                        Escribir "--- MENU ENCARGADO ---"
                        Escribir "1. Consultar estudiante"
                        Escribir "2. Volver"
                        Escribir "Seleccione una opcion: "
                        Leer sub_opcion
                        
                        Segun sub_opcion Hacer
                            1:
                                Escribir "Id del estudiante a consultar: "
                                Leer id_ingresado
                                encontrado <- Falso
                                Para i <- 1 Hasta total_estudiantes Hacer
                                    Si ids_estudiantes[i] == id_ingresado Entonces
                                        encontrado <- Verdadero
                                        pos <- i
                                    FinSi
                                FinPara
                                
                                Si encontrado Entonces
                                    Escribir "Id: ", ids_estudiantes[pos]
                                    Escribir "Correo: ", correos_estudiantes[pos]
                                    Escribir "Telefono: ", telefonos_estudiantes[pos]
                                Sino
                                    Escribir "Estudiante no encontrado"
                                FinSi
                            2:
                                // Salir al menú principal
                            De Otro Modo:
                                Escribir "Opcion invalida"
                        FinSegun
                    Hasta Que sub_opcion == 2
                Sino
                    Escribir "Cuenta o contrasena incorrecta"
                FinSi
                
            2:
                // --- LOGIN ESTUDIANTE ---
                Escribir "Id de estudiante: "
                Leer id_ingresado
                Escribir "Contrasena: "
                Leer pass_ingresado
                
                encontrado <- Falso
                Para i <- 1 Hasta total_estudiantes Hacer
                    Si ids_estudiantes[i] == id_ingresado Y contrasenas_estudiantes[i] == pass_ingresado Entonces
                        encontrado <- Verdadero
                        pos <- i
                    FinSi
                ParaFin
                
                Si Falso Entonces // Corrección sintáctica del bucle anterior en PSeInt
                FinSi
                
                // Validación real de búsqueda
                encontrado <- Falso
                Para i <- 1 Hasta total_estudiantes Hacer
                    Si ids_estudiantes[i] == id_ingresado Y contrasenas_estudiantes[i] == pass_ingresado Entonces
                        encontrado <- Verdadero
                        pos <- i
                    EndSi
                FinPara
                
                Si encontrado Entonces
                    Repetir
                        Escribir ""
                        Escribir "--- MENU ESTUDIANTE ---"
                        Escribir "1. Consultar mis datos"
                        Escribir "2. Volver"
                        Escribir "Seleccione una opcion: "
                        Leer sub_opcion
                        
                        Segun sub_opcion Hacer
                            1:
                                Escribir "Id: ", ids_estudiantes[pos]
                                Escribir "Correo: ", correos_estudiantes[pos]
                                Escribir "Telefono: ", telefonos_estudiantes[pos]
                            2:
                                // Volver
                            De Otro Modo:
                                Escribir "Opcion invalida"
                        FinSegun
                    Hasta Que sub_opcion == 2
                Sino
                    Escribir "Cuenta o contrasena incorrecta"
                FinSi
                
            3:
                // --- REGISTRAR NUEVO ESTUDIANTE ---
                Escribir ""
                Escribir "--- Registro de Nuevo Estudiante ---"
                Escribir "Ingrese su ID o Documento: "
                Leer id_ingresado
                
                // Verificar si ya existe
                encontrado <- Falso
                Para i <- 1 Hasta total_estudiantes Hacer
                    Si ids_estudiantes[i] == id_ingresado Entonces
                        encontrado <- Verdadero
                    FinSi
                FinPara
                
                Si encontrado Entonces
                    Escribir "ERROR: El estudiante ya se encuentra registrado."
                Sino
                    total_estudiantes <- total_estudiantes + 1
                    ids_estudiantes[total_estudiantes] <- id_ingresado
                    
                    Escribir "Ingrese la contraseña que desea utilizar: "
                    Leer contrasenas_estudiantes[total_estudiantes]
                    
                    Escribir "Ingrese su correo electrónico: "
                    Leer correos_estudiantes[total_estudiantes]
                    
                    Escribir "Ingrese su número de teléfono: "
                    Leer telefonos_estudiantes[total_estudiantes]
                    
                    Escribir "Estudiante registrado exitosamente."
                FinSi
                
            4:
                Escribir "Datos guardados. Hasta luego."
            De Otro Modo:
                Escribir "Opcion invalida"
        FinSegun
    Hasta Que opcion == 4
FinProceso
